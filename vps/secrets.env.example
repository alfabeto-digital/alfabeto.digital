# Copy this file to secrets.env and fill in values.
# secrets.env is .gitignore'd — do NOT commit it.

# --- Required ---

# API token for Gerbil to authenticate against Pangolin's internal API.
# Generate in the Pangolin admin panel (Settings → API Tokens).
GERBIL_PANGOLIN_TOKEN=your-gerbil-api-token-here

# --- Optional ---

# Pangolin database encryption key (if supported by your version).
# PANGOLIN_SECRET_KEY=your-random-secret-here

# Traefik dashboard basic auth (if you enable the dashboard in traefik.toml).
# TRAEFIK_DASHBOARD_USER=admin
# TRAEFIK_DASHBOARD_PASSWORD_HASH=...  # htpasswd -nb admin yourpassword
