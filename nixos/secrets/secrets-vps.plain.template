# ============================================================
# TEMPLATE — COMMIT THIS FILE. NEVER FILL VALUES HERE.
#
# This file contains secrets for the VPS (Pangolin server).
# The VPS uses its OWN age key, separate from alfabeto.digital.
#
# Deployment instructions:
#
#   1. On the VPS, copy this file:
#        cp nixos/secrets/secrets-vps.plain.template \
#             nixos/secrets/secrets-vps.plain
#
#   2. Fill in secrets-vps.plain with real values (on the VPS
#      only — never on a dev machine or in the repo).
#
#   3. Generate a new age key for the VPS (first deploy only):
#        nix-shell -p age
#        mkdir -p /root/.config/sops/age
#        age-keygen -o /root/.config/sops/age/keys.txt
#        age-keygen -y /root/.config/sops/age/keys.txt
#      Copy the public key output. Update .sops.yaml in the
#      repo with it under the secrets-vps.yaml rule, then
#      commit and push that change.
#
#   4. Encrypt:
#        sops --encrypt \
#          --age "$(age-keygen -y /root/.config/sops/age/keys.txt)" \
#          nixos/secrets/secrets-vps.plain \
#          > nixos/secrets/secrets-vps.yaml
#
#   5. Delete the plain file:
#        rm nixos/secrets/secrets-vps.plain
#
# secrets-vps.plain and secrets-vps.yaml are listed in .gitignore
# and must never be committed. Only this .template file is committed.
# ============================================================
#
# Value generation guides:
#
# vps_root_password / vps_admin_password (hashed):
#   mkpasswd -m sha-512
#
# gerbil_pangolin_token:
#   Pangolin admin panel → Settings → API Tokens → Create token.

###############################################################
# VPS system passwords
###############################################################

# System passwords — generate with: mkpasswd -m sha-512
vps_root_password:  ""
vps_admin_password: ""

###############################################################
# Pangolin / Gerbil
###############################################################

# API token for Gerbil to authenticate with the Pangolin internal API.
# Generate in Pangolin admin panel: Settings → API Tokens.
gerbil_pangolin_token: ""
