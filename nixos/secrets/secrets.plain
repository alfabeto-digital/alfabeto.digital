# Fill in all values before encrypting with sops.
#
# INSTRUCTIONS:
#
# 1. Hashed passwords (root_password, admin_password):
#      mkpasswd -m sha-512
#
# 2. admin_ssh_key:
#      Paste the FULL contents of your public key file, e.g.:
#      cat ~/.ssh/id_ed25519.pub
#      Example: ssh-ed25519 AAAA... user@host
#    Also copy this key to /etc/secrets/initrd/authorized_keys
#    on the server before the first build (needed for initrd SSH unlock).
#
# 3. db_password:
#      Any strong password string (not hashed).
#
# 4. cloudflare_token:
#      Raw tunnel token from the Cloudflare Zero Trust dashboard.
#
# 5. luks_data_key:
#      A strong random string used as the LUKS key for nvme1.
#      Generate with:
#        python3 -c "import secrets; print(secrets.token_hex(32))"
#      You must also enroll this key in the LUKS header of nvme1:
#        cryptsetup luksAddKey /dev/nvme1n1
#      (paste the same value when prompted)
#
# After filling in all values, encrypt and delete this file:
#   sops --encrypt --age 'age1...' ./secrets/secrets.plain \
#     > ./secrets/secrets.yaml
#   rm ./secrets/secrets.plain

root_password: ""
admin_password: ""
admin_ssh_key: ""
db_password: ""
cloudflare_token: ""
luks_data_key: ""