# Fill in all values before encrypting with sops.
#
# INSTRUCTIONS:
#
# 1. Hashed passwords (root_password, admin_password):
#      mkpasswd -m sha-512
#
# 2. db_password:
#      Any strong password string (not hashed).
#
# 3. newt_client_id / newt_client_secret / newt_server_url:
#      Credentials for the Newt tunnel client (Pangolin admin panel → Sites → Newt client).
#
# 4. luks_data_key:
#      A strong random string used as the LUKS key for nvme1.
#      Generate with:
#        python3 -c "import secrets; print(secrets.token_hex(32))"
#      Enroll in the LUKS header:
#        echo -n "$LUKS_KEY" > /tmp/luks.key && truncate -s -1 /tmp/luks.key
#        cryptsetup luksAddKey /dev/nvme1n1 /tmp/luks.key && rm /tmp/luks.key
#
# 5. authelia_jwt_secret / authelia_session_secret / authelia_storage_key:
#      Random 64-character strings. Generate each with:
#        python3 -c "import secrets; print(secrets.token_hex(32))"
#
# 6. authelia_smtp_password:
#      Password for the authelia@alfabeto.digital account in Stalwart.
#      Generate with:
#        python3 -c "import secrets; print(secrets.token_hex(20))"
#
# 7. stalwart_admin_password:
#      Password for the Stalwart web admin (username: admin).
#      Generate with:
#        python3 -c "import secrets; print(secrets.token_hex(20))"
#
# 8. dendrite_private_key:
#      Matrix homeserver signing key. Generate with:
#        nix shell nixpkgs#dendrite -c generate-keys --private-key /tmp/matrix_key.pem
#        cat /tmp/matrix_key.pem   # paste the full PEM block here
#      (Multi-line values must be indented under the key in YAML.)
#
# After filling in all values, encrypt and delete this file:
#   sops --encrypt --age 'age1...' ./secrets/secrets.plain \
#     > ./secrets/secrets.yaml
#   rm ./secrets/secrets.plain

