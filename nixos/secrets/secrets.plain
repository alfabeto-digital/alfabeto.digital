# Fill in all values before encrypting with sops.
#
# INSTRUCTIONS:
#
# 1. Hashed passwords (root_password, admin_password):
#      mkpasswd -m sha-512
#
# 2. db_password:
#      Any strong password string (not hashed).
#
# 3. cloudflare_token:
#      Raw tunnel token from the Cloudflare Zero Trust dashboard.
#      (Temporary — removed when Pangolin replaces Cloudflare in Paso 4.)
#
# 4. luks_data_key:
#      A strong random string used as the LUKS key for nvme1.
#      Generate with:
#        python3 -c "import secrets; print(secrets.token_hex(32))"
#      Enroll in the LUKS header:
#        echo -n "$LUKS_KEY" > /tmp/luks.key && truncate -s -1 /tmp/luks.key
#        cryptsetup luksAddKey /dev/nvme1n1 /tmp/luks.key && rm /tmp/luks.key
#
# 5. authelia_jwt_secret / authelia_session_secret / authelia_storage_key:
#      Random 64-character strings. Generate each with:
#        python3 -c "import secrets; print(secrets.token_hex(32))"
#
# 6. authelia_smtp_password:
#      Password for the authelia@alfabeto.digital account in Stalwart.
#      Generate with:
#        python3 -c "import secrets; print(secrets.token_hex(20))"
#
# 7. dendrite_private_key:
#      Matrix homeserver signing key. Generate with:
#        nix shell nixpkgs#dendrite -c generate-keys --private-key /tmp/matrix_key.pem
#        cat /tmp/matrix_key.pem   # paste the full PEM block here
#      (Multi-line values must be indented under the key in YAML.)
#
# After filling in all values, encrypt and delete this file:
#   sops --encrypt --age 'age1...' ./secrets/secrets.plain \
#     > ./secrets/secrets.yaml
#   rm ./secrets/secrets.plain

###############################################################
# System
###############################################################

root_password:  ""
admin_password: ""

###############################################################
# Storage
###############################################################

luks_data_key: ""

# initird: cryptsetup open /dev/disk/by-uuid/3dc51b73-ffa4-4813-8b83-e29a0e3458aa nixos-root
luks_root_key: ""

###############################################################
# Database
###############################################################

db_password: ""

###############################################################
# Network / tunnel
###############################################################

cloudflare_token: ""

###############################################################
# Authelia (SSO / 2FA)
###############################################################

authelia_jwt_secret:     ""
authelia_session_secret: ""
authelia_storage_key:    ""
authelia_smtp_password:  ""

###############################################################
# Dendrite (Matrix)
###############################################################

# Paste the full PEM contents here, indented:
# dendrite_private_key: |
#   -----BEGIN MATRIX PRIVATE KEY-----
#   ...
#   -----END MATRIX PRIVATE KEY-----
dendrite_private_key: ""

###############################################################
# Authelia (users file — YAML, stored encrypted in sops)
###############################################################

# Generate password hash (run on the server):
#   nix run nixpkgs#authelia -- crypto hash generate argon2 --password 'YourPassword'
#
# Paste the YAML content indented under the key:
authelia_users_file: |
  users:
    coyote:
      displayname: "coyote"
      password: ""
      email: coyote@alfabeto.digital
      groups:
        - admins
