# ============================================================
# TEMPLATE — COMMIT THIS FILE. NEVER FILL VALUES HERE.
#
# Deployment instructions:
#
#   1. On the homeserver, copy this file:
#        cp nixos/secrets/secrets.plain.template \
#             nixos/secrets/secrets.plain
#
#   2. Fill in secrets.plain with real values (on the server
#      only — never on a dev machine or in the repo).
#
#   3. Generate an SSH deploy key for this host (first deploy only):
#        ssh-keygen -t ed25519 -f /root/.ssh/id_ed25519 -N ""
#        cat /root/.ssh/id_ed25519.pub
#      Add the public key to the private GitHub repository:
#        GitHub → Settings → Deploy keys → Add deploy key (read-only).
#      Paste the public key into host_ssh_public_key below.
#
#   4. Get the age public key for this host:
#        age-keygen -y /root/.config/sops/age/keys.txt
#      Copy the public key output. Create .sops.yaml from the
#      template on this server and fill in the key:
#        cp .sops.yaml.template .sops.yaml
#
#   5. Encrypt:
#        sops --encrypt \
#          --age "$(age-keygen -y /root/.config/sops/age/keys.txt)" \
#          nixos/secrets/secrets.plain \
#          > nixos/secrets/secrets.yaml
#
#   6. Delete the plain file:
#        rm nixos/secrets/secrets.plain
#
# secrets.plain and secrets.yaml are listed in .gitignore and
# must never be committed. Only this .template file is committed.
# ============================================================
#
# Value generation guides:
#
# 1. root_password / admin_password (hashed):
#      mkpasswd -m sha-512
#
# 2. db_password:
#      Any strong password string (not hashed).
#
# 3. newt_client_id / newt_client_secret / newt_server_url:
#      Pangolin admin panel → Sites → your site → Newt client.
#
# 4. luks_data_key:
#      python3 -c "import secrets; print(secrets.token_hex(32))"
#      Enroll in the LUKS header:
#        echo -n "$LUKS_KEY" > /tmp/luks.key && truncate -s -1 /tmp/luks.key
#        cryptsetup luksAddKey /dev/nvme1n1 /tmp/luks.key && rm /tmp/luks.key
#
# 5. authelia_jwt_secret / authelia_session_secret / authelia_storage_key:
#      python3 -c "import secrets; print(secrets.token_hex(32))"
#
# 6. authelia_smtp_password:
#      python3 -c "import secrets; print(secrets.token_hex(20))"
#
# 7. stalwart_admin_password:
#      python3 -c "import secrets; print(secrets.token_hex(20))"
#
# 8. dendrite_private_key:
#      nix shell nixpkgs#dendrite -c generate-keys --private-key /tmp/matrix_key.pem
#      cat /tmp/matrix_key.pem   # paste the full PEM block here
#      (Multi-line values must be indented under the key in YAML.)

###############################################################
# SSH deploy key (private repository access)
###############################################################

# Generate with: ssh-keygen -t ed25519 -f /root/.ssh/id_ed25519 -N ""
# Then add the public key to GitHub: Settings → Deploy keys → Add deploy key (read-only).
# Clone the repo via SSH: git clone git@github.com:<org>/<repo>.git
host_ssh_public_key: ""

###############################################################
# System
###############################################################

root_password:  ""
admin_password: ""

###############################################################
# Storage
###############################################################

luks_data_key: ""

# initrd: cryptsetup open /dev/disk/by-uuid/<data_disk_uuid> nixos-root
luks_root_key: ""

###############################################################
# Database
###############################################################

db_password: ""

###############################################################
# Network / tunnel (Pangolin / Newt)
###############################################################

# Client ID from the Pangolin admin panel (Sites → your site → Newt client).
newt_client_id:     ""

# Client secret from the Pangolin admin panel.
newt_client_secret: ""

# URL of the Pangolin server (e.g. https://pangolin.yourvps.example.com).
newt_server_url:    ""

###############################################################
# Authelia (SSO / 2FA)
###############################################################

authelia_jwt_secret:     ""
authelia_session_secret: ""
authelia_storage_key:    ""
authelia_smtp_password:  ""

###############################################################
# Authelia (users file — YAML, stored encrypted in sops)
###############################################################

# Generate password hash (run on the server):
#   nix run nixpkgs#authelia -- crypto hash generate argon2 --password 'YourPassword'
#
# Paste the YAML content indented under the key:
authelia_users_file: |
  users:
    <admin_username>:
      displayname: ""
      password: ""
      email: ""
      groups:
        - admins

###############################################################
# Stalwart (mail server)
###############################################################

stalwart_admin_password: ""

# Password for the admin user mailbox (<admin_username>@<domain>, IMAP/webmail login).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(20))"
admin_mail_password: ""

###############################################################
# Dendrite (Matrix)
###############################################################

# Paste the full PEM contents here, indented:
# dendrite_private_key: |
#   -----BEGIN MATRIX PRIVATE KEY-----
#   ...
#   -----END MATRIX PRIVATE KEY-----
dendrite_private_key: ""

###############################################################
# Cloudflare token - remove after migration
###############################################################

cloudflare_token: ""
