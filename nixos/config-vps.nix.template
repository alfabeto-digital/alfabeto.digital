# ============================================================
# TEMPLATE — COMMIT THIS FILE. NEVER FILL VALUES HERE.
#
# Instructions:
#   1. On the VPS, copy this file:
#        cp nixos/config-vps.nix.template nixos/config-vps.nix
#   2. Fill in all values in config-vps.nix (on the VPS only).
#   3. Build the system:
#        nixos-rebuild switch --flake /path/to/repo/nixos#<hostname>
#
# config-vps.nix is listed in .gitignore and must never be committed.
# Only this .template file is committed.
# ============================================================

{
  ###############################################################
  # NixOS version
  ###############################################################

  nixos_state_version = "25.11";

  ###############################################################
  # System
  ###############################################################

  hostname = "";   # system hostname (used in nixosConfigurations key)
  timezone = "";   # e.g. "America/New_York" — timedatectl list-timezones

  locale_lang = "";   # e.g. "en_US.UTF-8"

  keyboard_console = "";   # console keymap (loadkeys)
  keyboard_x11     = "";   # X11 keymap     (localectl set-x11-keymap)

  ###############################################################
  # Users
  ###############################################################

  admin_username = "";   # primary admin user (same as on homeserver)

  # SSH public key for the admin user.
  # paste the full contents of ~/.ssh/id_ed25519.pub here.
  admin_ssh_key = "";   # ssh-keygen -t ed25519; cat ~/.ssh/id_ed25519.pub

  initrd_ssh_port = 2222;

  ###############################################################
  # Network / tunnel (Pangolin server)
  ###############################################################

  domain = "";   # primary domain, same as homeserver config.nix

  # Public IP of this VPS. Fill before first deploy.
  vps_ip = "FILL_VPS_PUBLIC_IP";

  # Internal Pangolin API port (Gerbil connects here).
  pangolin_port = 3000;

  # WireGuard peer IP assigned by Pangolin to the Newt client on the homeserver.
  # Fill after the first Newt connection (visible in Pangolin admin panel → Sites → peers).
  newt_peer_ip = "FILL_AFTER_NEWT_CONNECTS";

  ###############################################################
  # Container runtime
  ###############################################################

  # "flake"  = native NixOS services (pkgs.fosrl-pangolin, pkgs.fosrl-gerbil, services.traefik)
  # "podman" = OCI containers via virtualisation.oci-containers + Podman backend
  # "docker" = OCI containers via virtualisation.oci-containers + Docker backend
  # Docker and Podman are ALWAYS installed on the VPS regardless of this value.
  container_runtime = "flake";
}
