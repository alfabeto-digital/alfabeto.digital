# ============================================================
# TEMPLATE — selfhosted server. COMMIT THIS FILE.
#
# Instructions:
#   1. On the selfhosted server:
#        cp .sops.yaml.template .sops.yaml
#   2. Fill in this server's age public key:
#        age-keygen -y /root/.config/sops/age/keys.txt
#   3. Delete the VPS template (not needed on this server):
#        rm .sops-vps.yaml.template
#   4. .sops.yaml is gitignored — it stays on the server only.
#
# With .sops.yaml in place, `sops --encrypt` auto-selects the
# right key without needing --age on the command line.
# ============================================================

creation_rules:
  - path_regex: nixos/secrets/secrets\.yaml$
    age: "FILL_AGE_PUBLIC_KEY"
