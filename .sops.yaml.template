# ============================================================
# TEMPLATE — COMMIT THIS FILE. NEVER FILL VALUES HERE.
#
# Instructions:
#   1. cp .sops.yaml.template .sops.yaml
#   2. Fill in the age public keys for each host (on the server).
#      To get a host's public key:
#        age-keygen -y /root/.config/sops/age/keys.txt
#   3. .sops.yaml is listed in .gitignore — it stays on each
#      server only. Only this .template file is committed.
#
# With .sops.yaml in place, `sops --encrypt` auto-selects the
# right key per file without needing --age on the command line.
# ============================================================

creation_rules:
  - path_regex: nixos/secrets/secrets-vps\.yaml$
    age: "FILL_VPS_AGE_PUBLIC_KEY"
  - path_regex: nixos/secrets/secrets\.yaml$
    age: "FILL_ALFABETO_DIGITAL_AGE_PUBLIC_KEY"
